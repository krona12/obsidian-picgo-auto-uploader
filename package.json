{
  "name": "picgo-auto-uploader",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "main.js",
  "description": "Safely upload Obsidian attachments through PicGo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krona12/obsidian-picgo-auto-uploader.git"
  },
  "bugs": {
    "url": "https://github.com/krona12/obsidian-picgo-auto-uploader/issues"
  },
  "homepage": "https://github.com/krona12/obsidian-picgo-auto-uploader#readme",
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run package",
    "package": "npm run build && node scripts/check-release.mjs",
    "version": "node scripts/version-bump.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.config.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "happy-dom": "^21.0.3",
    "obsidian": "^1.14.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
